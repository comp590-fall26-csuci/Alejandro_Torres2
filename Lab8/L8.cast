[811.681155, "o", "CC = gcc\r\nCFLAGS = -Wall -Wextra -Iheaders\r\nTARGET = program\r\nSRC = main.c fibonacci.c\r\n\r\nall: $(TARGET)\r\n\r\n$(TARGET): $(SRC)\r\n\t$(CC) $(CFLAGS) $(SRC) -o $(TARGET)\r\n\r\nclean:\r\n\trm -f $(TARGET)\r\n\r\nrun: $(TARGET)\r\n\t./$(TARGET)\r\n\u001b[?2004h\u001b]0;alex@Debian: ~/Alejandro_Torres2/Lab8\u0007\u001b[01;32malex@Debian\u001b[00m:\u001b[01;34m~/Alejandro_Torres2/Lab8\u001b[00m$ "]

[1337.267666, "o", "\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[A\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C/Alejandro_Torres2/Lab8$ cat ../L4/590MakefileLab/Makefile"]
[1337.271124, "o", "\r\n\rCC = gcc\r\n\rCFLAGS = -Wall -Wextra -Iheaders\r\n\rTARGET = program\r\n\rSRC = main.c fibonacci.c\r\n\r\n\rall: $(TARGET)\r\n\r\n\r$(TARGET): $(SRC)\r\n\r        $(CC) $(CFLAGS) $(SRC) -o $(TARGET)\r\n\r\n\rclean:\r\n\r        rm -f $(TARGET)\r\n\r\n\rrun: $(TARGET)\r\n\r        ./$(TARGET)\r\n\ralex@Debian:~/Alejandro_Torres2/Lab8$ ls -R ../L4/590MakefileLab\r\n\r../L4/590MakefileLab:\r\n\rfibonacci.c  headers  LICENSE  main.c  Makefile\r\n\r\n\r../L4/590MakefileLab/headers:\r\n\rfibonacci.h  utest.h\r\n\r"]

[1326.56158, "o", "\u001b[7m/Alejandro_Torres2/Lab8$ cat ../L4/590Make\u001b[27m\u001b[7mf\u001b[27m\u001b[7mileLab/Makefile\u0000\u001b[27m\r\n"]
[1326.570009, "o", "\r\u001b[7mCC = gcc\u001b[27m\r\n\r\u001b[7mCFLAGS = -Wall -Wextra -Iheaders\u001b[27m\r\n\r\u001b[7mTARGET = program\u001b[27m\r\n\r\u001b[7mSRC = main.c fibonacci.c\u001b[27m\r\n\r\n\r\u001b[7mall: $(TARGET)\u001b[27m\r\n\r\n\r\u001b[7m$(TARGET): $(SRC)\u001b[27m\r\n\r\u001b[7m        $(CC) $(CFLAGS) $(SRC) -o $(TARGET)\u001b[27m\r\n\r\n\r\u001b[7mclean:\u001b[27m\r\n\r\u001b[7m        rm -f $(TARGET)\u001b[27m\r\n\r\n\r\u001b[7mrun: $(TARGET)\u001b[27m\r\n"]
[1326.57062, "o", "\r\u001b[7m        ./$(TARGET)\u001b[27m\r\n\r\u001b[7malex@Debian:~/Alejandro_Torres2/Lab8$ ls -R ../L4/590MakefileLab\u001b[27m\r\n\r\u001b[7m../L4/590MakefileLab:\u001b[27m\r\n"]
[1326.571038, "o", "\r\u001b[7mfibonacci.c  headers  LICENSE  main.c  Makefile\u001b[27m\r\n\r\n\r\u001b[7m../L4/590MakefileLab/headers:\u001b[27m\r\n\r\u001b[7mfibonacci.h  utest.h\u001b[27m\r\n\r"]

[0.023, "o", "error: unknown switch `m'\r\nusage: git add [<options>] [--] <pathspec>...\r\n\r\n    -n, --[no-]dry-run    dry run\r\n    -v, --[no-]verbose    be verbose\r\n\r\n    -i, --[no-]interactive\r\n                          interactive picking\r\n    -p, --[no-]patch      select hunks interactively\r\n    -U, --unified <n>     generate diffs with <n> lines context\r\n    "]
[0.000, "o", "--inter-hunk-context <n>\r\n                          show context between diff hunks up to the specified number of lines\r\n    -e, --[no-]edit       edit current diff and apply\r\n"]
[0.000, "o", "    -f, --[no-]force      allow adding otherwise ignored files"]
[0.000, "o", "\r\n    -u"]
[0.000, "o", ", --[no-]update"]
[0.000, "o", "     update tracked files\r\n    "]
[0.001, "o", "--[no-]renormalize    "]
[0.000, "o", "renormalize EOL of tracked files (implies -u)\r\n    -N, "]
[0.000, "o", "--[no-]intent-to-add"]
[0.000, "o", "\r\n                          record only the fact that the path will be added later"]
[0.000, "o", "\r\n"]
[0.000, "o", "    -A, --[no-]all        add changes from all tracked and untracked files\r\n    --[no-]ignore-removal ignore paths removed in the working tree (same as --no-all)\r\n    --[no-]refresh        don't add, only refresh the index\r\n    --[no-]ignore-errors"]
[0.000, "o", "  just skip files which cannot be added because of errors\r\n    --[no-]ignore-missing check if - even missing - files are ignored in dry run\r\n    --[no-]sparse"]
[0.000, "o", "         allow updating entries outside of the sparse-checkout cone\r\n    "]
[0.000, "o", "--[no-]chmod (+|-)x"]
[0.000, "o", "   "]
[0.000, "o", "override the executable bit of the listed files"]
[0.000, "o", "\r\n"]
[0.000, "o", "    --[no-]pathspec-from-file <file>"]
[0.000, "o", "\r\n                          read pathspec from file"]
[0.000, "o", "\r\n    --[no-]pathspec-file-nul"]
[0.000, "o", "\r\n                          with --pathspec-from-file, pathspec elements are separated with NUL character\r\n"]

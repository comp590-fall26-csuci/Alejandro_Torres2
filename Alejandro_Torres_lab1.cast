[0.001, "o", "\u001b[1;1H\u001b[J\u001b[7m  UW PICO 5.09                         File: lab1.py                            \u001b[27m\u001b[3;1Hdef fibonacci_iterative(n):\u001b[4;5Hsequence = []\u001b[5;5Ha, b = 0, 1\u001b[7;5Hfor _ in range(n):\u001b[8;9Hsequence.append(a)\u001b[9;9Ha, b = b, a + b\u001b[11;5Hreturn sequence\u001b[14;1Hwith open(\"output/fibonacci.txt\", \"w\") as file:\u001b[15;5Hfor number in fibonacci_iterative(25):\u001b[16;9Hfile.write(str(number) + \"\\n\")\u001b[23;1H\u001b[K\u001b[24;1H\u001b[K\u001b[23;1H\u001b[7m^\u001b[27m\u001b[7mG\u001b[27m Get Help  \u001b[7m^\u001b[27m\u001b[7mO\u001b[27m WriteOut  \u001b[7m^\u001b[27m\u001b[7mR\u001b[27m Read File \u001b[7m^\u001b[27m\u001b[7mY\u001b[27m Prev Pg   \u001b[7m^\u001b[27m\u001b[7mK\u001b[27m Cut Text  \u001b[7m^\u001b[27m\u001b[7mC\u001b[27m Cur Pos   \u001b[K"]

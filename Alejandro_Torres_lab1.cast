[0.000, "o", "\u001b[1;1H\u001b[J\u001b[7m  UW PICO 5.09                         File: lab1.py                            \u001b[27m\u001b[3;1Hdef fibonacci_recursive(n):\u001b[4;5Hif n <= 0:\u001b[5;9Hreturn []\u001b[6;5Hif n == 1:\u001b[7;9Hreturn [0]\u001b[9;5Hsequence = fibonacci_recursive(n - 1)\u001b[10;5Hsequence.append(sequence[-1] + sequence[-2] if len(sequence) > 1 else 1)\u001b[12;5Hreturn sequence\u001b[15;1Hwith open(\"output/fibonacci.txt\", \"w\") as file:\u001b[16;5Hfor number in fibonacci_recursive(25):\u001b[17;9Hfile.write(str(number) + \"\\n\")\u001b[23;1H\u001b[K\u001b[24;1H\u001b[K\u001b[23;1H\u001b[7m^\u001b[27m\u001b[7mG\u001b[27m Get Help  \u001b[7m^\u001b[27m\u001b[7mO\u001b[27m WriteOut  \u001b[7m^\u001b[27m\u001b[7mR\u001b[27m Read File \u001b[7m^\u001b[27m\u001b[7mY\u001b[27m Prev Pg   \u001b[7m^\u001b[27m\u001b[7mK\u001b[27m Cut Text  \u001b[7m^\u001b[27m\u001b[7mC\u001b[27m Cur Pos   \u001b[K"]
[0.001, "o", "\u001b[24;1H\u001b[7m^\u001b[27m\u001b[7mX\u001b[27m Exit      \u001b[7m^\u001b[27m\u001b[7mJ\u001b[27m Justify   \u001b[7m^\u001b[27m\u001b[7mW\u001b[27m Where is  \u001b[7m^\u001b[27m\u001b[7mV\u001b[27m Next Pg   \u001b[7m^\u001b[27m\u001b[7mU\u001b[27m UnCut Text\u001b[7m^\u001b[27m\u001b[7mT\u001b[27m To Spell  \u001b[K\u001b[3;1H"]

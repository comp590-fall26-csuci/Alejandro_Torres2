[0.015, "o", "\u001b[?1049h\u001b[1;24r\u001b[1;1H\u001b[J\u001b[7m  UW PICO 5.09                           New Buffer                             \u001b[27m\u001b[23;1H\u001b[K\u001b[24;1H\u001b[K\u001b[23;1H\u001b[7m^\u001b[27m\u001b[7mG\u001b[27m Get Help  \u001b[7m^\u001b[27m\u001b[7mO\u001b[27m WriteOut  \u001b[7m^\u001b[27m\u001b[7mR\u001b[27m Read File \u001b[7m^\u001b[27m\u001b[7mY\u001b[27m Prev Pg   \u001b[7m^\u001b[27m\u001b[7mK\u001b[27m Cut Text  \u001b[7m^\u001b[27m\u001b[7mC\u001b[27m Cur Pos   \u001b[K\u001b[24;1H\u001b[7m^\u001b[27m\u001b[7mX\u001b[27m Exit      \u001b[7m^\u001b[27m\u001b[7mJ\u001b[27m Justify   \u001b[7m^\u001b[27m\u001b[7mW\u001b[27m Where is  \u001b[7m^\u001b[27m\u001b[7mV\u001b[27m Next Pg   \u001b[7m^\u001b[27m\u001b[7mU\u001b[27m UnCut Text\u001b[7m^\u001b[27m\u001b[7mT\u001b[27m To Spell  \u001b[K\u001b[3;1H"]
